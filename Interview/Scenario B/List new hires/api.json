{
  "get": {
    "summary": "List all new hires and their system statuses",
    "responses": {
      "200": {
        "description": "New hires",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "systems": { "type": "array", "items": { "type": "object", "properties": { "key": { "type": "string" }, "label": { "type": "string" } } } },
                "hires": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
              }
            }
          }
        }
      }
    }
  }
}
