{
  "post": {
    "summary": "Set one system's provisioning status for a new hire",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": ["id", "system", "status"],
            "properties": {
              "id": { "type": "integer" },
              "system": { "enum": ["active_directory", "microsoft_365", "epic", "badge_system", "clinical_apps"] },
              "status": { "enum": ["Pending", "In Progress", "Done"] }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "Updated",
        "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "overall_status": { "type": "string" } } } } }
      },
      "400": { "description": "Validation error" },
      "404": { "description": "Unknown new hire" }
    }
  }
}
