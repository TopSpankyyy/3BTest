{
  "post": {
    "summary": "Record a new hire access request",
    "requestBody": {
      "required": true,
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": ["full_name", "email", "department", "job_title", "start_date", "manager_name", "systems"],
            "properties": {
              "full_name": { "type": "string" },
              "email": { "type": "string", "format": "email" },
              "department": { "type": "string" },
              "job_title": { "type": "string" },
              "start_date": { "type": "string", "format": "date" },
              "manager_name": { "type": "string" },
              "systems": {
                "type": "array",
                "minItems": 1,
                "items": { "enum": ["active_directory", "microsoft_365", "epic", "badge_system", "clinical_apps"] }
              }
            }
          }
        }
      }
    },
    "responses": {
      "200": {
        "description": "New hire saved",
        "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "id": { "type": "integer" } } } } }
      },
      "400": { "description": "Validation error" }
    }
  }
}
